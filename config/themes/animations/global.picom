animations = ({
    triggers = ["open"];
    preset = "appear";
    scale = 0.92;
    duration = 0.22;
}, {
    triggers = ["close"];
    preset = "disappear";
    scale = 1.05;
    duration = 0.2;
}, {
    # Show — cascading fly-in
    triggers = ["show"];
    preset = "fly-in";
    direction = "up";
    duration = 0.2;
}, {
    # Hide — cascading fly-out
    triggers = ["hide"];
    preset = "fly-out";
    direction = "down";
    duration = 0.15;
});
