# Opcional: Eliminar bordes de ventana
default_border pixel 0
default_floating_border pixel 0

# Servicios gráficos (picom, polybar, conky) - manejados por script unificado
exec_always --no-startup-id ~/.config/themes/scripts/start-services.sh

# Polybar (también lanzado desde apply-polybar.sh / toggle-powersaver.sh)
