# DPMS: apagar pantalla a los 5 min, standby 6 min, off 7 min
exec --no-startup-id xset dpms 300 360 420

# xautolock: bloquear tras 8 min de inactividad (antes de DPMS off)
exec --no-startup-id xautolock -time 8 -locker "$HOME/.config/themes/bin/lock.sh" -detectsleep

