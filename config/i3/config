exec --no-startup-id xrdb -merge ~/.Xresources

# Cerrar el dock al iniciar i3
exec --no-startup-id killall -9 plank

# Control de Brillo con Notificaciones
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/brightness.sh +5%
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/brightness.sh 5%-

